# ---------- apps/web (Vercel) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 首頁 Hero：orbit | storybook | carousel（預設 orbit）
NEXT_PUBLIC_HERO=orbit
# 站台網址（黑貓PAY apn_url / success_url 用；正式環境必填，且必須 https）
NEXT_PUBLIC_SITE_URL=https://planet-pi-seven.vercel.app
# 黑貓PAY（統一客樂得 COCS 線上刷卡，收單統一金流；契客 好日子股份有限公司，與小時光／快樂手同帳號）
# CUST_ID / API_PASSWORD / WEBHOOK_SECRET 任一未設 = 不導金流（訂單／報名維持 pending、人工收費）
BLACKCAT_CUST_ID=
BLACKCAT_API_PASSWORD=
BLACKCAT_HASH_BASE=
# 只有 "false" 才打正式機 cocs.4128888card.com.tw；其他值 = 測試機
BLACKCAT_SANDBOX=true
# APN 網址 ?k= 閘門（本站自己產生的隨機字串）
BLACKCAT_WEBHOOK_SECRET=
# 選填：收單行（預設 payuni）、限定產品別（例 payuni.normal＝只收一次付清）
BLACKCAT_ACQUIRER_TYPE=
BLACKCAT_LIMIT_PRODUCT_ID=
# 光貿 Amego 電子發票（付款成功後自動開 B2C）；BAN/APP_KEY 任一未設 = 不開發票（留在 invoices 待補開）
AMEGO_INVOICE_BAN=
AMEGO_APP_KEY=
# Amego 有 IP 白名單 → 經 Railway 固定 IP 中繼（header x-relay-secret）；兩個都設才走中繼
AMEGO_RELAY_URL=
AMEGO_RELAY_SECRET=
# 定期對帳 /api/pay/reconcile-cron 的 secret（同值存在 Supabase Vault：planet_cron_secret；pg_cron job planet-pay-reconcile 每 10 分鐘呼叫）
CRON_SECRET=
# 付款需人工處理時通知營運（Resend；未設定只寫 log）
RESEND_API_KEY=
MAIL_FROM=十二星球 <noreply@gathertaiwan.com>
ADMIN_NOTIFY_EMAIL=

# ---------- apps/worker (Railway) ----------
SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=   (同上)
WEB_URL=
PUBLIC_URL=
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
# production | stage（預設 stage）
ECPAY_ENV=stage
LINEPAY_CHANNEL_ID=
LINEPAY_CHANNEL_SECRET=
# production | sandbox（預設 sandbox）
LINEPAY_ENV=sandbox
RESEND_API_KEY=
MAIL_FROM=
TZ=Asia/Taipei
PORT=8787

# ---------- CI / scripts/apply-migrations.mjs ----------
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
