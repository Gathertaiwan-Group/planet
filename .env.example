# ---------- apps/web (Vercel) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 首頁 Hero：orbit | storybook | carousel（預設 orbit）
NEXT_PUBLIC_HERO=orbit
# 站台網址（PChomePay return_url / notify_url 用）
NEXT_PUBLIC_SITE_URL=https://planet-pi-seven.vercel.app
# PChomePay 支付連（金流全在 web 端；APP_ID/SECRET 任一未設 = 不導金流，訂單/報名維持 pending）
PCHOMEPAY_APP_ID=
PCHOMEPAY_SECRET=
# "true" = sandbox（sandbox-api.pchomepay.com.tw）；其他值 = 正式
PCHOMEPAY_SANDBOX=true
PCHOMEPAY_PAY_TYPES=CARD,ATM

# ---------- apps/worker (Railway) ----------
SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=   (同上)
WEB_URL=
PUBLIC_URL=
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
# production | stage（預設 stage）
ECPAY_ENV=stage
LINEPAY_CHANNEL_ID=
LINEPAY_CHANNEL_SECRET=
# production | sandbox（預設 sandbox）
LINEPAY_ENV=sandbox
RESEND_API_KEY=
MAIL_FROM=
TZ=Asia/Taipei
PORT=8787

# ---------- CI / scripts/apply-migrations.mjs ----------
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
